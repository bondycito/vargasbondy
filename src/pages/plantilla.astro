---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { squadMembers, staffMembers } from "../data/site";
import BONDY from "src/components/Animationplayer.astro";
import DynamicBanner from "src/components/DynamicBanner.astro";
import Animationplayer from "src/components/Animationplayer.astro";

const groups = ["Todos", "Porteros", "Defensas", "Mediocampistas", "Delanteros"] as const;

const roleSummaries: Record<(typeof groups)[number], string> = {
  Todos: "Una plantilla armada para competir con intensidad, equilibrio y profundidad en cada línea.",
  Porteros: "Seguridad bajo palos, orden en salida y presencia para sostener al equipo en momentos clave.",
  Defensas: "Una línea hecha para imponer duelos, cubrir amplitud y sostener el ritmo competitivo.",
  Mediocampistas: "Energía, lectura táctica y circulación para conectar recuperación con ataque.",
  Delanteros: "Gol, agresividad y movilidad en el último tercio para castigar cada espacio.",
};
---

<BaseLayout title="Chankas CYC | Plantilla">
  <Animationplayer title="PLANTILLA"
    subtitle="Plantel principal y cuerpo técnico del club, presentados con una lectura más clara, jerarquía visual fuerte y filtros más útiles."
  />
  <section class="surface-light py-16 sm:py-20">
    
    <div class="container-shell">
      <div class="mb-10 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
          <span class="eyebrow">Plantel oficial</span>
          <h2 class="mt-5 font-heading text-3xl font-black uppercase tracking-[0.14em] text-brand-ink sm:text-4xl">
            Una plantilla pensada para competir
          </h2>
          
          <p class="mt-4 text-sm leading-7 text-black/62 sm:text-base">
            Cada ficha resume rol, dorsal, nacionalidad, edad y rendimiento reciente para ofrecer una lectura más limpia del equipo.
          </p>
        </div>

        <div class="rounded-[1.5rem] border border-black/8 bg-white px-5 py-4 shadow-[0_12px_30px_rgba(15,23,42,0.06)]">
          <p class="font-heading text-[0.64rem] font-black uppercase tracking-[0.24em] text-black/40">Plantel actual</p>
          <p class="mt-2 font-heading text-3xl font-black uppercase text-brand-garnet">{squadMembers.length} jugadores</p>
        </div>
      </div>

  
      <div class="mb-6 rounded-[1.75rem] border border-black/8 bg-white p-4 shadow-[0_14px_34px_rgba(15,23,42,0.06)] sm:p-5">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-2xl">
            <p id="squad-summary" class="text-sm leading-7 text-black/60 sm:text-base">
              {roleSummaries.Todos}
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            {
              groups.map((group, index) => (
                <button
                  type="button"
                  class:list={[
                    "squad-filter rounded-full border px-4 py-2.5 font-heading text-sm font-bold tracking-[0.06em] transition",
                    index === 0
                      ? "border-brand-garnet bg-brand-garnet text-white shadow-[0_10px_22px_rgba(145,31,33,0.18)]"
                      : "border-black/10 bg-white text-black/62 hover:border-brand-gold/50 hover:bg-brand-gold/10 hover:text-brand-garnet",
                  ]}
                  data-role={group}
                  data-summary={roleSummaries[group]}
                >
                  {group}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {
          squadMembers.map((player) => (
            <article
              class="squad-card group overflow-hidden rounded-[1.9rem] border border-black/8 bg-white shadow-[0_16px_40px_rgba(15,23,42,0.07)] transition hover:-translate-y-1 hover:shadow-[0_24px_46px_rgba(145,31,33,0.12)]"
              data-role={player.role}
            >
              <div class="relative aspect-[4/4.2] overflow-hidden bg-[radial-gradient(circle_at_top,#5b1115_0%,#2d0709_48%,#140506_100%)]">
                <div class="absolute inset-0 texture-grid opacity-40"></div>
                <div class="absolute left-5 top-5 flex items-center gap-3">
                  <span class="inline-flex rounded-full bg-brand-gold px-3 py-1 font-heading text-[0.64rem] font-black uppercase tracking-[0.16em] text-brand-ink">
                    {player.role}
                  </span>
                  {player.captain && (
                    <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-brand-gold/30 bg-brand-gold/18 font-heading text-xs font-black uppercase text-brand-gold">
                      C
                    </span>
                  )}
                </div>
                <div class="absolute right-5 top-4 font-display text-[5rem] leading-none text-brand-gold/24 sm:text-[5.75rem]">
                  {player.number > 0 ? player.number : "--"}
                </div>
                <img
                  src={player.image}
                  alt={player.name}
                  class="absolute inset-x-0 bottom-0 h-full w-full object-cover object-top transition duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black via-black/18 to-transparent"></div>
                <div class="absolute inset-x-0 bottom-0 p-6">
                  <p class="font-heading text-[0.66rem] font-black uppercase tracking-[0.24em] text-brand-gold/80">
                    Dorsal {player.number > 0 ? player.number : "--"}
                  </p>
                  <h3 class="mt-3 font-heading text-2xl font-black uppercase leading-8 tracking-[0.06em] text-white">
                    {player.name}
                  </h3>
                </div>
              </div>

              <div class="p-6">
                <div class="grid grid-cols-2 gap-3 rounded-[1.4rem] bg-black/[0.03] p-4 text-sm">
                  <div>
                    <p class="font-heading text-[0.62rem] font-black uppercase tracking-[0.18em] text-black/35">Nacionalidad</p>
                    <p class="mt-2 font-heading text-sm font-black uppercase tracking-[0.08em] text-brand-ink">{player.nationality}</p>
                  </div>
                  <div>
                    <p class="font-heading text-[0.62rem] font-black uppercase tracking-[0.18em] text-black/35">Edad</p>
                    <p class="mt-2 font-heading text-sm font-black uppercase tracking-[0.08em] text-brand-ink">{player.age > 0 ? `${player.age} años` : "Edad no publicada"}</p>
                  </div>
                </div>

                <div class="mt-5 border-t border-black/8 pt-5">
                  <p class="font-heading text-[0.62rem] font-black uppercase tracking-[0.18em] text-black/35">Rendimiento reciente</p>
                  <p class="mt-3 text-sm leading-7 text-black/64">{player.stats}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
 <section class="h-screen bg-black flex items-center justify-center">
  <DynamicBanner title="Alineacion del principal" formacion="5-3-2" />
  
</section>
  <section class="bg-brand-ink py-16 sm:py-20">
    <div class="container-shell">
      <div class="mb-10 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <span class="eyebrow">Cuerpo técnico</span>
          <h2 class="mt-5 section-title">Staff principal</h2>
          <p class="mt-4 text-sm leading-7 text-white/62 sm:text-base">
            El equipo de trabajo que sostiene la preparación táctica, física y competitiva del plantel.
          </p>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {
          staffMembers.map((member) => (
            <article class="overflow-hidden rounded-[1.75rem] border border-white/8 bg-white/[0.04] shadow-[0_14px_34px_rgba(0,0,0,0.2)] backdrop-blur-sm transition hover:-translate-y-1 hover:border-brand-gold/25">
              <div class="relative aspect-[4/4.1] overflow-hidden">
                <img src={member.image} alt={member.name} class="h-full w-full object-cover object-top transition duration-500 hover:scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/68 via-black/12 to-transparent"></div>
                <div class="absolute inset-x-0 bottom-0 p-6">
                  <p class="font-heading text-[0.66rem] font-black uppercase tracking-[0.24em] text-brand-gold">
                    {member.role}
                  </p>
                  <h3 class="mt-3 font-heading text-xl font-black uppercase leading-7 tracking-[0.06em] text-white">
                    {member.name}
                  </h3>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <script is:inline>
    const buttons = document.querySelectorAll(".squad-filter");
    const cards = document.querySelectorAll(".squad-card");
    const summary = document.getElementById("squad-summary");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const role = button.dataset.role;
        const copy = button.dataset.summary;

        buttons.forEach((node) => {
          node.classList.remove("border-brand-garnet", "bg-brand-garnet", "text-white", "shadow-[0_10px_22px_rgba(145,31,33,0.18)]");
          node.classList.add("border-black/10", "bg-white", "text-black/62");
        });

        button.classList.add("border-brand-garnet", "bg-brand-garnet", "text-white", "shadow-[0_10px_22px_rgba(145,31,33,0.18)]");
        button.classList.remove("border-black/10", "bg-white", "text-black/62");

        if (summary && copy) summary.textContent = copy;

        cards.forEach((card) => {
          card.classList.toggle("hidden", role !== "Todos" && card.dataset.role !== role);
        });
      });
    });
  </script>
</BaseLayout>

