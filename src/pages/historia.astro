---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout title="Chankas CYC | Historia">
  <PageHero
    title="HISTORIA"
    subtitle="La memoria del club contada con una lectura más clara, una línea de tiempo sólida y una presencia visual más contundente."
  />

  <section class="surface-light relative overflow-hidden py-16 sm:py-20">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,164,0,0.12),transparent_32%)]"></div>
    <div class="container-shell relative max-w-4xl text-center">
      <span class="eyebrow">Fundado el 30 de agosto de 1989</span>
      <h2 class="mt-5 font-display text-3xl leading-tight tracking-[0.08em] text-brand-garnet sm:mt-6 sm:text-6xl sm:tracking-[0.12em]">
        Identidad, memoria y comunidad
      </h2>
      <p class="mt-6 text-sm leading-7 text-black/70 sm:mt-8 sm:text-lg sm:leading-8">
        Los Chankas CYC no son solo un club de fútbol. Son una expresión del orgullo de Andahuaylas y
        de la identidad deportiva de Apurímac, construida paso a paso desde el esfuerzo local hasta la
        Primera División.
      </p>
      <div class="mx-auto mt-8 h-1 w-20 bg-gradient-to-r from-transparent via-brand-gold to-transparent sm:mt-10 sm:w-24"></div>
    </div>
  </section>

  <section class="surface-light relative border-t border-black/8 py-14 sm:py-16">
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(145,31,33,0.03)_0%,transparent_24%,transparent_76%,rgba(255,164,0,0.06)_100%)]"></div>
    <div class="container-shell relative">
      <div class="relative mx-auto max-w-5xl">
        <div class="absolute bottom-0 left-7 top-0 w-px bg-gradient-to-b from-brand-gold/20 via-brand-gold/45 to-brand-garnet/15 lg:hidden"></div>
        <div class="absolute bottom-0 left-1/2 top-0 hidden w-px -translate-x-1/2 bg-gradient-to-b from-brand-gold/10 via-brand-gold/55 to-brand-garnet/20 lg:block"></div>
        <div class="space-y-8 sm:space-y-10">
          <article class="relative pl-20 lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-start lg:gap-6 lg:pl-0">
            <div class="order-2 lg:col-start-1 lg:order-none">
              <div class="group overflow-hidden rounded-[2rem] border border-black/8 bg-white shadow-[0_20px_48px_rgba(0,0,0,.08)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_26px_54px_rgba(0,0,0,.12)]">
                <div class="relative overflow-hidden">
                  <img
                    src="Estadio/8.png"
                    alt="Fundación del club"
                    class="h-48 w-full object-cover transition duration-500 group-hover:scale-[1.04] sm:h-56"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-brand-ink/45 via-transparent to-transparent"></div>
                  <div class="absolute left-4 top-4 inline-flex rounded-full border border-brand-gold/30 bg-white/85 px-3 py-2 font-heading text-[0.58rem] font-black uppercase tracking-[0.2em] text-brand-garnet backdrop-blur-sm sm:left-5 sm:top-5 sm:px-4 sm:text-[0.62rem] sm:tracking-[0.24em]">
                    Orígenes
                  </div>
                </div>
                <div class="p-5 sm:p-7">
                  <p class="font-heading text-[0.62rem] font-black uppercase tracking-[0.26em] text-black/35">Capítulo 1</p>
                  <h2 class="mt-3 font-heading text-lg font-black uppercase leading-snug tracking-[0.05em] text-brand-ink sm:text-2xl sm:tracking-[0.06em]">
                    Fundación del club
                  </h2>
                  <p class="mt-3 text-sm leading-6 text-black/68 sm:mt-4 sm:text-[0.95rem] sm:leading-7">
                    El club fue fundado el 30 de agosto de 1989 en Andahuaylas. Desde entonces empezó a
                    formarse una institución que con los años se convertiría en una de las mayores
                    referencias deportivas de Apurímac.
                  </p>
                </div>
              </div>
            </div>
            <div class="absolute left-0 top-0 order-1 flex items-start justify-center lg:relative lg:left-auto lg:top-auto lg:order-none">
              <div class="relative flex h-14 w-14 items-center justify-center rounded-full border-4 border-brand-gold/20 bg-[linear-gradient(135deg,#911f21_0%,#6f1618_100%)] shadow-[0_18px_36px_rgba(145,31,33,.22)] sm:h-16 sm:w-16 lg:h-20 lg:w-20">
                <div class="absolute inset-1 rounded-full border border-brand-gold/25"></div>
                <div class="font-display text-[1rem] tracking-[0.05em] text-brand-gold sm:text-[1.15rem] lg:text-[2rem] lg:tracking-[0.08em]">1989</div>
              </div>
            </div>
            <div class="hidden lg:col-start-3 lg:block lg:text-left">
              <div class="pt-5 font-heading text-[0.72rem] font-extrabold uppercase tracking-[0.34em] text-black/35">1989</div>
              <div class="mt-3 h-px w-20 bg-gradient-to-r from-brand-gold/0 via-brand-gold/50 to-brand-gold/0"></div>
            </div>
          </article>

          <article class="relative pl-20 lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-start lg:gap-6 lg:pl-0">
            <div class="order-2 lg:col-start-3 lg:order-none">
              <div class="group overflow-hidden rounded-[2rem] border border-black/8 bg-white shadow-[0_20px_48px_rgba(0,0,0,.08)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_26px_54px_rgba(0,0,0,.12)]">
                <div class="relative overflow-hidden">
                  <img
                    src="https://tudiariohuanuco.pe/wp-content/uploads/2023/10/estadio-andahuaylas.jpg" 
                    alt="Campaña histórica en Copa Perú"
                    class="h-48 w-full object-cover transition duration-500 group-hover:scale-[1.04] sm:h-56"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-brand-ink/45 via-transparent to-transparent"></div>
                  <div class="absolute left-4 top-4 inline-flex rounded-full border border-brand-gold/30 bg-white/85 px-3 py-2 font-heading text-[0.58rem] font-black uppercase tracking-[0.2em] text-brand-garnet backdrop-blur-sm sm:left-5 sm:top-5 sm:px-4 sm:text-[0.62rem] sm:tracking-[0.24em]">
                    Crecimiento
                  </div>
                </div>
                <div class="p-5 sm:p-7">
                  <p class="font-heading text-[0.62rem] font-black uppercase tracking-[0.26em] text-black/35">Capítulo 2</p>
                  <h2 class="mt-3 font-heading text-lg font-black uppercase leading-snug tracking-[0.05em] text-brand-ink sm:text-2xl sm:tracking-[0.06em]">
                    Campaña histórica en Copa Perú
                  </h2>
                  <p class="mt-3 text-sm leading-6 text-black/68 sm:mt-4 sm:text-[0.95rem] sm:leading-7">
                    En 2015, cuando todavía competía como Cultural Santa Rosa, el club alcanzó los
                    octavos de final de la Copa Perú. Esa campaña fue una señal clara de crecimiento y
                    de ambición deportiva.
                  </p>
                </div>
              </div>
            </div>
            <div class="absolute left-0 top-0 order-1 flex items-start justify-center lg:relative lg:left-auto lg:top-auto lg:order-none">
              <div class="relative flex h-14 w-14 items-center justify-center rounded-full border-4 border-brand-gold/20 bg-[linear-gradient(135deg,#911f21_0%,#6f1618_100%)] shadow-[0_18px_36px_rgba(145,31,33,.22)] sm:h-16 sm:w-16 lg:h-20 lg:w-20">
                <div class="absolute inset-1 rounded-full border border-brand-gold/25"></div>
                <div class="font-display text-[1rem] tracking-[0.05em] text-brand-gold sm:text-[1.15rem] lg:text-[2rem] lg:tracking-[0.08em]">2015</div>
              </div>
            </div>
            <div class="hidden lg:col-start-1 lg:row-start-1 lg:block lg:text-right">
              <div class="pt-5 font-heading text-[0.72rem] font-extrabold uppercase tracking-[0.34em] text-black/35">2015</div>
              <div class="mt-3 h-px w-20 bg-gradient-to-r from-brand-gold/0 via-brand-gold/50 to-brand-gold/0"></div>
            </div>
          </article>

          <article class="relative pl-20 lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-start lg:gap-6 lg:pl-0">
            <div class="order-2 lg:col-start-1 lg:order-none">
              <div class="group overflow-hidden rounded-[2rem] border border-black/8 bg-white shadow-[0_20px_48px_rgba(0,0,0,.08)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_26px_54px_rgba(0,0,0,.12)]">
                <div class="relative overflow-hidden">
                  <img
                    src="https://cdn.futbolperuano.com/sdi/2024/12/31/los-chankas-esperan-ser-locales-en-andahuaylas-en-la-liga-1-2025-1268097.webp"
                    alt="Ingreso a la Segunda División"
                    class="h-48 w-full object-cover transition duration-500 group-hover:scale-[1.04] sm:h-56"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-brand-ink/45 via-transparent to-transparent"></div>
                  <div class="absolute left-4 top-4 inline-flex rounded-full border border-brand-gold/30 bg-white/85 px-3 py-2 font-heading text-[0.58rem] font-black uppercase tracking-[0.2em] text-brand-garnet backdrop-blur-sm sm:left-5 sm:top-5 sm:px-4 sm:text-[0.62rem] sm:tracking-[0.24em]">
                    Profesionalización
                  </div>
                </div>
                <div class="p-5 sm:p-7">
                  <p class="font-heading text-[0.62rem] font-black uppercase tracking-[0.26em] text-black/35">Capítulo 3</p>
                  <h2 class="mt-3 font-heading text-lg font-black uppercase leading-snug tracking-[0.05em] text-brand-ink sm:text-2xl sm:tracking-[0.06em]">
                    Ingreso a la Segunda División
                  </h2>
                  <p class="mt-3 text-sm leading-6 text-black/68 sm:mt-4 sm:text-[0.95rem] sm:leading-7">
                    A partir de 2016, el club pasó a competir en la Segunda División del fútbol peruano.
                    Ese ingreso marcó el comienzo de una etapa más exigente y profesional dentro de su
                    trayectoria.
                  </p>
                </div>
              </div>
            </div>
            <div class="absolute left-0 top-0 order-1 flex items-start justify-center lg:relative lg:left-auto lg:top-auto lg:order-none">
              <div class="relative flex h-14 w-14 items-center justify-center rounded-full border-4 border-brand-gold/20 bg-[linear-gradient(135deg,#911f21_0%,#6f1618_100%)] shadow-[0_18px_36px_rgba(145,31,33,.22)] sm:h-16 sm:w-16 lg:h-20 lg:w-20">
                <div class="absolute inset-1 rounded-full border border-brand-gold/25"></div>
                <div class="font-display text-[1rem] tracking-[0.05em] text-brand-gold sm:text-[1.15rem] lg:text-[2rem] lg:tracking-[0.08em]">2016</div>
              </div>
            </div>
            <div class="hidden lg:col-start-3 lg:block lg:text-left">
              <div class="pt-5 font-heading text-[0.72rem] font-extrabold uppercase tracking-[0.34em] text-black/35">2016</div>
              <div class="mt-3 h-px w-20 bg-gradient-to-r from-brand-gold/0 via-brand-gold/50 to-brand-gold/0"></div>
            </div>
          </article>

          <article class="relative pl-20 lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-start lg:gap-6 lg:pl-0">
            <div class="order-2 lg:col-start-3 lg:order-none">
              <div class="group overflow-hidden rounded-[2rem] border border-black/8 bg-white shadow-[0_20px_48px_rgba(0,0,0,.08)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_26px_54px_rgba(0,0,0,.12)]">
                <div class="relative overflow-hidden">
                  <img
                    src="https://images.unsplash.com/photo-1431324155629-1a6deb1dec8d?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1200"
                    alt="Golpe nacional en Copa Bicentenario"
                    class="h-48 w-full object-cover transition duration-500 group-hover:scale-[1.04] sm:h-56"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-brand-ink/45 via-transparent to-transparent"></div>
                  <div class="absolute left-4 top-4 inline-flex rounded-full border border-brand-gold/30 bg-white/85 px-3 py-2 font-heading text-[0.58rem] font-black uppercase tracking-[0.2em] text-brand-garnet backdrop-blur-sm sm:left-5 sm:top-5 sm:px-4 sm:text-[0.62rem] sm:tracking-[0.24em]">
                    Hazaña
                  </div>
                </div>
                <div class="p-5 sm:p-7">
                  <p class="font-heading text-[0.62rem] font-black uppercase tracking-[0.26em] text-black/35">Capítulo 4</p>
                  <h2 class="mt-3 font-heading text-lg font-black uppercase leading-snug tracking-[0.05em] text-brand-ink sm:text-2xl sm:tracking-[0.06em]">
                    Golpe nacional en Copa Bicentenario
                  </h2>
                  <p class="mt-3 text-sm leading-6 text-black/68 sm:mt-4 sm:text-[0.95rem] sm:leading-7">
                    El 11 de junio de 2021, el equipo eliminó a Alianza Lima por penales en la Copa
                    Bicentenario. Fue uno de los resultados más recordados de su historia reciente y una
                    muestra del carácter competitivo del club.
                  </p>
                </div>
              </div>
            </div>
            <div class="absolute left-0 top-0 order-1 flex items-start justify-center lg:relative lg:left-auto lg:top-auto lg:order-none">
              <div class="relative flex h-14 w-14 items-center justify-center rounded-full border-4 border-brand-gold/20 bg-[linear-gradient(135deg,#911f21_0%,#6f1618_100%)] shadow-[0_18px_36px_rgba(145,31,33,.22)] sm:h-16 sm:w-16 lg:h-20 lg:w-20">
                <div class="absolute inset-1 rounded-full border border-brand-gold/25"></div>
                <div class="font-display text-[1rem] tracking-[0.05em] text-brand-gold sm:text-[1.15rem] lg:text-[2rem] lg:tracking-[0.08em]">2021</div>
              </div>
            </div>
            <div class="hidden lg:col-start-1 lg:row-start-1 lg:block lg:text-right">
              <div class="pt-5 font-heading text-[0.72rem] font-extrabold uppercase tracking-[0.34em] text-black/35">2021</div>
              <div class="mt-3 h-px w-20 bg-gradient-to-r from-brand-gold/0 via-brand-gold/50 to-brand-gold/0"></div>
            </div>
          </article>

          <article class="relative pl-20 lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-start lg:gap-6 lg:pl-0">
            <div class="order-2 lg:col-start-1 lg:order-none">
              <div class="group overflow-hidden rounded-[2rem] border border-black/8 bg-white shadow-[0_20px_48px_rgba(0,0,0,.08)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_26px_54px_rgba(0,0,0,.12)]">
                <div class="relative overflow-hidden">
                  <img
                    src="https://scontent-lim1-1.xx.fbcdn.net/v/t39.30808-6/471540054_1140452958084284_8739669092637843902_n.jpg?_nc_cat=102&ccb=1-7&_nc_sid=53a332&_nc_eui2=AeGQKme_MnU5xbS9FSSXIqIeJEJwz391FowkQnDPf3UWjL7LEEYRIxDFah7XUjk-Y9VA9oRQSrimSnkLP7ZceSSh&_nc_ohc=cZ2migsFEawQ7kNvwF9aGUw&_nc_oc=Adrr66_kt2yBREAz2M3oStA-SzH078vEhBDWOlPFEYZ7MPK_9LVlX7OpiNh4LMXHKfNyenGWoLQBWb10OkU4EFYz&_nc_zt=23&_nc_ht=scontent-lim1-1.xx&_nc_gid=85ElOYLGxWWZ1YXO4ATwUw&_nc_ss=7b2a8&oh=00_Af63q8rMp5021FWZou6pz4zL80m9EZtkl3JucpsNNhmGNQ&oe=69FFB192"
                    alt="Identidad Los Chankas CYC"
                    class="h-48 w-full object-cover transition duration-500 group-hover:scale-[1.04] sm:h-56"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-brand-ink/45 via-transparent to-transparent"></div>
                  <div class="absolute left-4 top-4 inline-flex rounded-full border border-brand-gold/30 bg-white/85 px-3 py-2 font-heading text-[0.58rem] font-black uppercase tracking-[0.2em] text-brand-garnet backdrop-blur-sm sm:left-5 sm:top-5 sm:px-4 sm:text-[0.62rem] sm:tracking-[0.24em]">
                    Identidad
                  </div>
                </div>
                <div class="p-5 sm:p-7">
                  <p class="font-heading text-[0.62rem] font-black uppercase tracking-[0.26em] text-black/35">Capítulo 5</p>
                  <h2 class="mt-3 font-heading text-lg font-black uppercase leading-snug tracking-[0.05em] text-brand-ink sm:text-2xl sm:tracking-[0.06em]">
                    Identidad Los Chankas CYC
                  </h2>
                  <p class="mt-3 text-sm leading-6 text-black/68 sm:mt-4 sm:text-[0.95rem] sm:leading-7">
                    Durante 2021 se consolidó la identidad Los Chankas CYC, reforzando el vínculo del
                    club con la historia, la cultura y el sentido de pertenencia de Andahuaylas y
                    Apurímac.
                  </p>
                </div>
              </div>
            </div>
            <div class="absolute left-0 top-0 order-1 flex items-start justify-center lg:relative lg:left-auto lg:top-auto lg:order-none">
              <div class="relative flex h-14 w-14 items-center justify-center rounded-full border-4 border-brand-gold/20 bg-[linear-gradient(135deg,#911f21_0%,#6f1618_100%)] shadow-[0_18px_36px_rgba(145,31,33,.22)] sm:h-16 sm:w-16 lg:h-20 lg:w-20">
                <div class="absolute inset-1 rounded-full border border-brand-gold/25"></div>
                <div class="font-display text-[1rem] tracking-[0.05em] text-brand-gold sm:text-[1.15rem] lg:text-[2rem] lg:tracking-[0.08em]">2021</div>
              </div>
            </div>
            <div class="hidden lg:col-start-3 lg:block lg:text-left">
              <div class="pt-5 font-heading text-[0.72rem] font-extrabold uppercase tracking-[0.34em] text-black/35">2021</div>
              <div class="mt-3 h-px w-20 bg-gradient-to-r from-brand-gold/0 via-brand-gold/50 to-brand-gold/0"></div>
            </div>
          </article>

          <article class="relative pl-20 lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-start lg:gap-6 lg:pl-0">
            <div class="order-2 lg:col-start-3 lg:order-none">
              <div class="group overflow-hidden rounded-[2rem] border border-black/8 bg-white shadow-[0_20px_48px_rgba(0,0,0,.08)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_26px_54px_rgba(0,0,0,.12)]">
                <div class="relative overflow-hidden">
                  <img
                    src="https://cdn.futbolperuano.com/sdi/2023/11/30/los-chankas-de-andahuaylas-inscribieron-3-estadios-para-la-liga-1-del-2024-1209318.webp"
                    alt="Ascenso histórico a la Liga 1"
                    class="h-48 w-full object-cover transition duration-500 group-hover:scale-[1.04] sm:h-56"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-brand-ink/45 via-transparent to-transparent"></div>
                  <div class="absolute left-4 top-4 inline-flex rounded-full border border-brand-gold/30 bg-white/85 px-3 py-2 font-heading text-[0.58rem] font-black uppercase tracking-[0.2em] text-brand-garnet backdrop-blur-sm sm:left-5 sm:top-5 sm:px-4 sm:text-[0.62rem] sm:tracking-[0.24em]">
                    Hito
                  </div>
                </div>
                <div class="p-5 sm:p-7">
                  <p class="font-heading text-[0.62rem] font-black uppercase tracking-[0.26em] text-black/35">Capítulo 6</p>
                  <h2 class="mt-3 font-heading text-lg font-black uppercase leading-snug tracking-[0.05em] text-brand-ink sm:text-2xl sm:tracking-[0.06em]">
                    Ascenso histórico a la Liga 1
                  </h2>
                  <p class="mt-3 text-sm leading-6 text-black/68 sm:mt-4 sm:text-[0.95rem] sm:leading-7">
                    El 27 de octubre de 2023, Los Chankas vencieron a Alianza Universidad en la final del
                    playoff y lograron el primer ascenso de su historia a la máxima categoría del fútbol
                    peruano.
                  </p>
                </div>
              </div>
            </div>
            <div class="absolute left-0 top-0 order-1 flex items-start justify-center lg:relative lg:left-auto lg:top-auto lg:order-none">
              <div class="relative flex h-14 w-14 items-center justify-center rounded-full border-4 border-brand-gold/20 bg-[linear-gradient(135deg,#911f21_0%,#6f1618_100%)] shadow-[0_18px_36px_rgba(145,31,33,.22)] sm:h-16 sm:w-16 lg:h-20 lg:w-20">
                <div class="absolute inset-1 rounded-full border border-brand-gold/25"></div>
                <div class="font-display text-[1rem] tracking-[0.05em] text-brand-gold sm:text-[1.15rem] lg:text-[2rem] lg:tracking-[0.08em]">2023</div>
              </div>
            </div>
            <div class="hidden lg:col-start-1 lg:row-start-1 lg:block lg:text-right">
              <div class="pt-5 font-heading text-[0.72rem] font-extrabold uppercase tracking-[0.34em] text-black/35">2023</div>
              <div class="mt-3 h-px w-20 bg-gradient-to-r from-brand-gold/0 via-brand-gold/50 to-brand-gold/0"></div>
            </div>
          </article>

          <article class="relative pl-20 lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-start lg:gap-6 lg:pl-0">
            <div class="order-2 lg:col-start-1 lg:order-none">
              <div class="group overflow-hidden rounded-[2rem] border border-black/8 bg-white shadow-[0_20px_48px_rgba(0,0,0,.08)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_26px_54px_rgba(0,0,0,.12)]">
                <div class="relative overflow-hidden">
                  <img
                    src="https://radiotropikana.pe/content/img_noticia/Captura%20de%20pantalla%202026-03-08%20210420.png"
                    alt="Apurímac llega a Primera"
                    class="h-48 w-full object-cover transition duration-500 group-hover:scale-[1.04] sm:h-56"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-brand-ink/45 via-transparent to-transparent"></div>
                  <div class="absolute left-4 top-4 inline-flex rounded-full border border-brand-gold/30 bg-white/85 px-3 py-2 font-heading text-[0.58rem] font-black uppercase tracking-[0.2em] text-brand-garnet backdrop-blur-sm sm:left-5 sm:top-5 sm:px-4 sm:text-[0.62rem] sm:tracking-[0.24em]">
                    Presente
                  </div>
                </div>
                <div class="p-5 sm:p-7">
                  <p class="font-heading text-[0.62rem] font-black uppercase tracking-[0.26em] text-black/35">Capítulo 7</p>
                  <h2 class="mt-3 font-heading text-lg font-black uppercase leading-snug tracking-[0.05em] text-brand-ink sm:text-2xl sm:tracking-[0.06em]">
                    Apurímac llega a Primera
                  </h2>
                  <p class="mt-3 text-sm leading-6 text-black/68 sm:mt-4 sm:text-[0.95rem] sm:leading-7">
                    Desde la temporada 2024, Los Chankas compiten en la Liga 1 y se convirtieron en el
                    primer representante de Apurímac en la Primera División del Perú, un logro histórico
                    para la región.
