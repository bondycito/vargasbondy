---
// navbarLogo.astro
interface Props {
    size?: number;
}

const { size = 44 } = Astro.props;

// Importar la imagen (Astro la optimiza automáticamente)
import logo from "../assets/img/Logo.png";
// O si está en assets: import logo from "../assets/logo.png";

const containerHeight = size * 1.15;
---

<div style={`width:${size}px; height:${containerHeight}px; flex-shrink: 0;`}>
    <img
        src={logo.src}
        alt="Chankas Cycling Club Logo"
        width={size}
        height={containerHeight}
        style="width: 100%; height: 100%; object-fit: contain;"
    />
</div>
