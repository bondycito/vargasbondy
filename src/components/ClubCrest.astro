---
interface Props {
  size?: number;
  glow?: boolean;
}

const { size = 88, glow = false } = Astro.props;
---

<div
  style={`width:${size}px;height:${Math.round(size * 1.15)}px;${glow ? "filter:drop-shadow(0 0 24px rgba(255,164,0,.65));" : ""}`}
  class="shrink-0"
>
  <svg viewBox="0 0 100 115" fill="none" xmlns="http://www.w3.org/2000/svg" class="size-full">
    <path d="M50 2 L95 18 L95 55 C95 80 73 102 50 113 C27 102 5 80 5 55 L5 18 Z" fill="#911F21" stroke="#FFA400" stroke-width="2.5" />
    <path d="M50 2 L95 18 L95 30 L5 30 L5 18 Z" fill="#7A1A1C" />
    <rect x="5" y="47" width="90" height="5" fill="#FFA400" opacity="0.3" />
    <text x="50" y="72" text-anchor="middle" dominant-baseline="middle" fill="#FFA400" font-size="26" font-family="Bebas Neue, sans-serif" letter-spacing="2">CYC</text>
    <text x="26" y="24" text-anchor="middle" fill="#FFA400" font-size="10">★</text>
    <text x="50" y="24" text-anchor="middle" fill="#FFA400" font-size="10">★</text>
    <text x="74" y="24" text-anchor="middle" fill="#FFA400" font-size="10">★</text>
    <path d="M20 85 Q50 100 80 85" stroke="#FFA400" stroke-width="1.5" fill="none" opacity="0.6" />
  </svg>
</div>
