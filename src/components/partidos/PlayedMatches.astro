---
import { playedMatches } from "../../data/partidos";
const sortedMatches = [...playedMatches].sort((a, b) => b.id - a.id);
---

<div
  data-panel-content="results"
  class="match-panel hidden grid gap-5 lg:grid-cols-2"
>
  {
    sortedMatches.map((match) => (
      <article class="overflow-hidden rounded-[1.75rem] border border-black/8 bg-white p-4 sm:p-6 shadow-[0_14px_34px_rgba(15,23,42,0.06)]">
        <div class="flex flex-wrap items-start justify-between gap-2 sm:gap-4">
          <div>
            <p class="font-heading text-[0.68rem] font-black uppercase tracking-[0.18em] text-brand-garnet">
              {match.shortCompetition}
            </p>
            <p class="mt-1 sm:mt-2 text-xs sm:text-sm text-black/55">
              {match.competition}
            </p>
          </div>
          <span class="rounded-full bg-black/8 px-3 py-1 font-heading text-[0.62rem] font-black uppercase tracking-[0.18em] text-black/55 whitespace-nowrap">
            Finalizado
          </span>
        </div>

        <div class="mt-4 sm:mt-6 grid grid-cols-[1fr_auto_1fr] items-center gap-2 sm:gap-4">
          <div class="min-w-0">
            <p class="font-heading text-[0.62rem] font-black uppercase tracking-[0.16em] text-black/35">
              Local
            </p>
            <div class="mt-2 sm:mt-3 flex flex-col lg:flex-row items-start lg:items-center gap-2 lg:gap-3">
              <img
                src={match.homeLogo}
                alt={match.home}
                class="h-10 w-10 sm:h-11 sm:w-11 shrink-0 rounded-full border border-black/8 bg-white object-contain p-1"
              />
              <h2
                class="min-w-0 font-heading text-base font-black uppercase tracking-[0.05em] text-brand-ink sm:text-lg leading-tight break-words"
                style="text-wrap: balance;"
              >
                {match.home}
              </h2>
            </div>
          </div>
          <div class="whitespace-nowrap text-center font-display text-4xl leading-none tracking-[0.12em] text-brand-garnet sm:text-5xl px-1 sm:px-3">
            {match.homeScore} - {match.awayScore}
          </div>
          <div class="min-w-0 text-right flex flex-col items-end">
            <p class="font-heading text-[0.62rem] font-black uppercase tracking-[0.16em] text-black/35">
              Visita
            </p>
            <div class="mt-2 sm:mt-3 flex flex-col-reverse lg:flex-row items-end lg:items-center justify-end gap-2 lg:gap-3">
              <h2
                class="min-w-0 font-heading text-base font-black uppercase tracking-[0.05em] text-brand-ink sm:text-lg leading-tight break-words text-right"
                style="text-wrap: balance;"
              >
                {match.away}
              </h2>
              <img
                src={match.awayLogo}
                alt={match.away}
                class="h-10 w-10 sm:h-11 sm:w-11 shrink-0 rounded-full border border-black/8 bg-white object-contain p-1"
              />
            </div>
          </div>
        </div>

        <div class="mt-4 sm:mt-6 grid gap-2 sm:gap-3 rounded-2xl bg-black/[0.03] p-3 sm:p-4 text-xs sm:text-sm text-black/62 sm:grid-cols-2">
          <p>
            {match.dateLabel} · {match.time}
          </p>
          <p class="sm:text-right">
            {match.stadium}, {match.city}
          </p>
        </div>
      </article>
    ))
  }
</div>
